generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

enum ProfessionalType {
  DOCTOR
  DENTIST
  PHYSIOTHERAPIST
  PSYCHOLOGIST
  NUTRITIONIST
  SPEECH_THERAPIST
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Company {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  document           String?
  phone              String?
  email              String?
  address             String?
  city                String?
  state               String?
  logoUrl             String?
  accentColor         String?            @default("#2563eb")
  onboardingCompleted Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  users               User[]
  professionals       Professional[]
  patients            Patient[]
  appointments        Appointment[]
  specialties         Specialty[]
  subscription        Subscription?
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(RECEPTIONIST)
  active       Boolean       @default(true)
  companyId    String?
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional Professional?
  sessions     Session[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Specialty {
  id            String         @id @default(cuid())
  name          String
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionals Professional[]
  createdAt     DateTime       @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model Professional {
  id                  String            @id @default(cuid())
  name                String
  email               String?
  phone               String?
  type                ProfessionalType
  council             String?
  registrationNumber  String?
  bio                 String?
  appointmentDuration Int               @default(30)
  active              Boolean           @default(true)
  companyId           String
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  specialtyId         String?
  specialty           Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  userId              String?           @unique
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilities      Availability[]
  appointments        Appointment[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([companyId])
  @@index([specialtyId])
}

model Availability {
  id             String       @id @default(cuid())
  weekday        Int
  startTime      String
  endTime        String
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model Patient {
  id           String        @id @default(cuid())
  name         String
  email        String?
  phone        String?
  document     String?
  birthDate    DateTime?
  insurance    String?
  notes        String?
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([companyId])
  @@index([name])
}

model Appointment {
  id             String            @id @default(cuid())
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  notes          String?
  companyId      String
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([companyId, startsAt])
  @@index([professionalId, startsAt])
  @@index([patientId])
}

model Subscription {
  id        String             @id @default(cuid())
  plan      String             @default("TRIAL")
  status    SubscriptionStatus @default(TRIAL)
  trialEnds DateTime?
  companyId String             @unique
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}
