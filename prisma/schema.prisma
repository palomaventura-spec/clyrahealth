generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  RECEPTIONIST
  PROFESSIONAL
}

enum ProfessionalType {
  DOCTOR
  DENTIST
  PHYSIOTHERAPIST
  PSYCHOLOGIST
  NUTRITIONIST
  SPEECH_THERAPIST
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
  TRANSFER
  INSURANCE
  OTHER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum NotificationChannel {
  INTERNAL
  EMAIL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum AutomationType {
  APPOINTMENT_CREATED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  REMINDER_24H
  REMINDER_2H
  AI_RECEPTION
}

enum ConversationStatus {
  OPEN
  HUMAN_HANDOFF
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageAuthor {
  PATIENT
  AI
  STAFF
  SYSTEM
}

enum PlanFeatureKey {
  WHATSAPP
  AI_RECEPTION
  AI_ASSISTANT
  ADVANCED_AUTOMATIONS
}

enum ClinicalDocumentType {
  PRESCRIPTION
  EXAM_REQUEST
  MEDICAL_CERTIFICATE
  ATTENDANCE_DECLARATION
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VIEW_CLINICAL
  CREATE_DOCUMENT
  CHANGE_APPOINTMENT
  CHANGE_ROLE
  PASSWORD_RESET
}

enum OrganizationKind {
  SOLO
  CLINIC
  HOSPITAL
  OTHER
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum BillingProvider {
  NONE
  ASAAS
}

enum BillingEnvironment {
  SANDBOX
  PRODUCTION
}

model Company {
  id                        String             @id @default(cuid())
  name                      String
  organizationKind          OrganizationKind   @default(CLINIC)
  publicName                String?
  loginHeadline             String?
  bookingHeadline           String?
  timezone                  String             @default("America/Sao_Paulo")
  whatsappStatus            IntegrationStatus  @default(DISCONNECTED)
  whatsappPhone             String?
  whatsappPhoneNumberId     String?
  whatsappBusinessAccountId String?
  slug                      String             @unique
  document                  String?
  phone                     String?
  email                     String?
  address                   String?
  city                      String?
  state                     String?
  logoUrl                   String?
  accentColor               String?            @default("#2563eb")
  onboardingCompleted       Boolean            @default(false)
  active                    Boolean            @default(true)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  users                     User[]
  professionals             Professional[]
  patients                  Patient[]
  appointments              Appointment[]
  specialties               Specialty[]
  scheduleBlocks            ScheduleBlock[]
  patientSessions           PatientSession[]
  consultations             Consultation[]
  medicalRecords            MedicalRecord[]
  clinicalNotes             ClinicalNote[]
  clinicalDocuments         ClinicalDocument[]
  billingSettings           BillingSettings?
  subscription              Subscription?
  notifications             Notification[]
  automations               AutomationRule[]
  conversations             Conversation[]
  planFeatures              PlanFeature[]
  auditLogs                 AuditLog[]
  units                     Unit[]
  protocolTemplates         ProtocolTemplate[]
  waitlistEntries           WaitlistEntry[]
}

model User {
  id                 String               @id @default(cuid())
  name               String
  email              String               @unique
  passwordHash       String
  role               UserRole             @default(RECEPTIONIST)
  active             Boolean              @default(true)
  mustChangePassword Boolean              @default(false)
  companyId          String?
  company            Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professional       Professional?
  sessions           Session[]
  auditLogs          AuditLog[]
  resetTokens        PasswordResetToken[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Specialty {
  id            String         @id @default(cuid())
  name          String
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionals Professional[]
  createdAt     DateTime       @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model Professional {
  id                  String             @id @default(cuid())
  name                String
  publicSlug          String?
  email               String?
  phone               String?
  type                ProfessionalType
  council             String?
  registrationNumber  String?
  bio                 String?
  appointmentDuration Int                @default(30)
  standardPriceCents  Int                @default(0)
  active              Boolean            @default(true)
  companyId           String
  company             Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  specialtyId         String?
  specialty           Specialty?         @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  userId              String?            @unique
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  availabilities      Availability[]
  appointments        Appointment[]
  scheduleBlocks      ScheduleBlock[]
  consultations       Consultation[]
  clinicalNotes       ClinicalNote[]
  clinicalDocuments   ClinicalDocument[]
  waitlistEntries     WaitlistEntry[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([companyId, publicSlug])
  @@index([companyId])
  @@index([specialtyId])
}

model Availability {
  id             String       @id @default(cuid())
  weekday        Int
  startTime      String
  endTime        String
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ScheduleBlock {
  id             String       @id @default(cuid())
  title          String       @default("Bloqueio")
  startsAt       DateTime
  endsAt         DateTime
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([companyId, startsAt])
  @@index([professionalId, startsAt])
}

model Patient {
  id                String             @id @default(cuid())
  name              String
  email             String?
  phone             String?
  document          String?
  birthDate         DateTime?
  sex               String?
  zipCode           String?
  street            String?
  addressNumber     String?
  complement        String?
  neighborhood      String?
  city              String?
  state             String?
  guardianName      String?
  guardianPhone     String?
  careType          String?            @default("PRIVATE")
  insurance         String?
  insurancePlan     String?
  insuranceCard     String?
  notes             String?
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  patientSessions   PatientSession[]
  medicalRecord     MedicalRecord?
  consultations     Consultation[]
  clinicalNotes     ClinicalNote[]
  clinicalDocuments ClinicalDocument[]
  conversations     Conversation[]
  waitlistEntries   WaitlistEntry[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([companyId, document])
  @@index([companyId])
  @@index([name])
}

model PatientSession {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([patientId])
  @@index([companyId])
}

model Appointment {
  id                String             @id @default(cuid())
  startsAt          DateTime
  endsAt            DateTime
  status            AppointmentStatus  @default(SCHEDULED)
  reason            String?
  notes             String?
  careType          String             @default("PRIVATE")
  grossAmountCents  Int                @default(0)
  discountCents     Int                @default(0)
  finalAmountCents  Int                @default(0)
  paymentStatus     PaymentStatus      @default(PENDING)
  paymentMethod     PaymentMethod?
  paidAt            DateTime?
  companyId         String
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalId    String
  professional      Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation      Consultation?
  clinicalDocuments ClinicalDocument[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId, startsAt])
  @@index([professionalId, startsAt])
  @@index([patientId])
}

model MedicalRecord {
  id        String         @id @default(cuid())
  patientId String         @unique
  patient   Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes     ClinicalNote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([companyId])
}

model Consultation {
  id             String             @id @default(cuid())
  appointmentId  String             @unique
  appointment    Appointment        @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complaint      String?
  anamnesis      String?
  examination    String?
  assessment     String?
  evolution      String?
  conduct        String?
  returnNotes    String?
  returnDate     DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  notes          ClinicalNote[]
  documents      ClinicalDocument[]

  @@index([companyId])
  @@index([patientId])
  @@index([professionalId])
}

model ClinicalNote {
  id              String        @id @default(cuid())
  content         String
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  consultationId  String?
  consultation    Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId  String
  professional    Professional  @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([patientId])
  @@index([professionalId])
}

model ClinicalDocument {
  id             String               @id @default(cuid())
  type           ClinicalDocumentType
  title          String
  body           String
  instructions   String?
  notes          String?
  issuedAt       DateTime             @default(now())
  companyId      String
  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   Professional         @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?        @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([companyId])
  @@index([patientId])
  @@index([professionalId])
  @@index([appointmentId])
}

model Subscription {
  id                     String             @id @default(cuid())
  plan                   String             @default("TRIAL")
  status                 SubscriptionStatus @default(TRIAL)
  trialStartedAt         DateTime?
  trialEnds              DateTime?
  companyId              String             @unique
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  billingProvider        BillingProvider    @default(NONE)
  providerCustomerId     String?
  providerSubscriptionId String?
  cancelAtPeriodEnd      Boolean            @default(false)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model Notification {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patientId     String?
  appointmentId String?
  channel       NotificationChannel
  status        NotificationStatus  @default(PENDING)
  recipient     String?
  subject       String?
  body          String
  providerId    String?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  @@index([companyId, createdAt])
  @@index([patientId])
  @@index([appointmentId])
}

model AutomationRule {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      AutomationType
  enabled   Boolean             @default(false)
  channel   NotificationChannel @default(INTERNAL)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, type])
  @@index([companyId])
}

model Conversation {
  id        String                @id @default(cuid())
  companyId String
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  patientId String?
  patient   Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  phone     String
  status    ConversationStatus    @default(OPEN)
  messages  ConversationMessage[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([companyId, updatedAt])
  @@index([phone])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  author         MessageAuthor
  content        String
  providerId     String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model PlanFeature {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  feature   PlanFeatureKey
  enabled   Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([companyId, feature])
  @@index([companyId])
}

model AuditLog {
  id          String      @id @default(cuid())
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      AuditAction
  entityType  String
  entityId    String?
  description String?
  metadata    String?
  createdAt   DateTime    @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  inviteKind String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Unit {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String?
  state     String?
  active    Boolean  @default(true)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model BillingSettings {
  id          String             @id @default(cuid())
  companyId   String             @unique
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider    BillingProvider    @default(NONE)
  environment BillingEnvironment @default(SANDBOX)
  enabled     Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model BillingWebhookEvent {
  id          String          @id @default(cuid())
  provider    BillingProvider
  eventId     String          @unique
  eventType   String
  payloadJson String
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([provider, createdAt])
}

model ProtocolTemplate {
  id          String   @id @default(cuid())
  name        String
  specialty   String?
  description String?
  complaint   String?
  anamnesis   String?
  examination String?
  assessment  String?
  evolution   String?
  conduct     String?
  returnNotes String?
  active      Boolean  @default(true)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, specialty])
}

model WaitlistEntry {
  id              String        @id @default(cuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  professionalId  String?
  professional    Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  specialty       String?
  preferredDays   String?
  preferredPeriod String?
  priority        String        @default("NORMAL")
  notes           String?
  status          String        @default("WAITING")
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId, status])
  @@index([patientId])
  @@index([professionalId])
}
